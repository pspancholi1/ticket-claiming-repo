# Postgres — matches docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ticket_claiming

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# How long a claim survives without agent activity.
CLAIM_TTL_MINUTES=15

# Run the pg-boss worker + sweeper in this process.
# Set false on API-only instances when the worker is deployed separately.
WORKER_ENABLED=true

# Mock notification provider (2-20s latency, ~1 in 5 failures)
NOTIFY_MIN_LATENCY_MS=2000
NOTIFY_MAX_LATENCY_MS=20000
NOTIFY_FAILURE_RATE=0.2

# Seconds before the first notification retry (backs off from here)
NOTIFY_RETRY_DELAY_SECONDS=5
